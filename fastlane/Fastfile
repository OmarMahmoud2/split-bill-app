require "fileutils"
require "shellwords"
require "fastlane_core/build_watcher"

default_platform(:ios)

ENV["PATH"] = "/usr/local/lib/ruby/gems/4.0.0/bin:/usr/local/opt/ruby/bin:/opt/homebrew/bin:#{ENV['PATH']}"

PROJECT_ROOT = File.expand_path("..", __dir__)
PUBSPEC_PATH = File.join(PROJECT_ROOT, "pubspec.yaml")
VERSION_MATCH = File.read(PUBSPEC_PATH).match(/^version:\s*([0-9A-Za-z.\-]+)\+(\d+)\s*$/)

UI.user_error!("Could not read app version from #{PUBSPEC_PATH}") unless VERSION_MATCH

APP_VERSION = VERSION_MATCH[1]
BUILD_NUMBER = VERSION_MATCH[2]
RELEASE_NOTES = File.read(File.join(PROJECT_ROOT, "fastlane", "metadata_v2", "en-US", "release_notes.txt")).strip
SYMBOLS_DIR = File.join(PROJECT_ROOT, "build", "symbols", "#{APP_VERSION}+#{BUILD_NUMBER}")
ANDROID_AAB = File.join(PROJECT_ROOT, "build", "app", "outputs", "bundle", "release", "app-release.aab")
IOS_IPA = File.join(PROJECT_ROOT, "build", "ios", "ipa", "split_bill_app.ipa")
FLUTTER_BIN = ENV.fetch("FLUTTER_BIN", "/Users/omarmahmoud/FlutterDev/flutter/bin/flutter")
IOS_METADATA_PATH = File.join(PROJECT_ROOT, "fastlane", "metadata_v2")
IOS_FILTERED_METADATA_PATH = File.join(PROJECT_ROOT, "build", "fastlane", "ios_metadata")
IOS_APP_IDENTIFIER = ENV.fetch("APP_IDENTIFIER", "com.example.splitBillApp")
PRIVACY_POLICY_URL = "https://omarmali.net/split-bill/privacy/"
TERMS_OF_USE_URL = "https://omarmali.net/split-bill/terms/"
IOS_APP_STORE_LOCALES = %w[
  ar-SA da de-DE en-AU en-CA en-GB en-US es-ES es-MX fr-CA fr-FR
  hi id it ja ko nl-NL no pl pt-BR pt-PT ru sv th tr vi zh-Hans zh-Hant
]
APP_REVIEW_NOTES = [
  "Version 1.2.0 (build #{BUILD_NUMBER}) is a security update.",
  "It updates the Cloud Firestore SDK to 12.19.3, which removes root certificates chaining to the compromised eMudhra intermediate CAs, as required by Google's Firebase security advisory.",
  "It also tightens account data access. There are no new features or changes to in-app purchases.",
  "To verify: sign in, create a bill, and open Profile > Go Premium; behaviour is unchanged.",
  "Privacy Policy: #{PRIVACY_POLICY_URL}",
  "Terms of Use (EULA): #{TERMS_OF_USE_URL}"
].join("\n")

def app_store_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_filepath: ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"],
    in_house: false
  )
end

def run_flutter_build(args)
  FileUtils.mkdir_p(SYMBOLS_DIR)
  Dir.chdir(PROJECT_ROOT) do
    sh(args.shelljoin)
  end
end

def build_android_aab
  ensure_file_exists!(File.join(PROJECT_ROOT, "android", "key.properties"), "Release signing configuration is required; do not upload a debug-signed bundle.")
  run_flutter_build([
    FLUTTER_BIN,
    "build",
    "aab",
    "--release",
    "--obfuscate",
    "--split-debug-info=#{SYMBOLS_DIR}",
    "--build-name=#{APP_VERSION}",
    "--build-number=#{BUILD_NUMBER}"
  ])
  ensure_file_exists!(ANDROID_AAB, "Android App Bundle was not produced.")
end

def build_ios_ipa
  # Prepare Flutter's release settings, then limit native compiler concurrency.
  run_flutter_build([
    FLUTTER_BIN,
    "build", "ios", "--release", "--config-only", "--target=lib/main.dart",
    "--obfuscate", "--split-debug-info=#{SYMBOLS_DIR}",
    "--build-name=#{APP_VERSION}", "--build-number=#{BUILD_NUMBER}"
  ])
  jobs = Integer(ENV.fetch("IOS_BUILD_JOBS", "2"))
  UI.user_error!("IOS_BUILD_JOBS must be positive") unless jobs.positive?
  build_app(
    workspace: File.join(PROJECT_ROOT, "ios", "Runner.xcworkspace"),
    scheme: "Runner",
    configuration: "Release",
    archive_path: File.join(PROJECT_ROOT, "build", "ios", "archive", "Runner.xcarchive"),
    output_directory: File.dirname(IOS_IPA),
    output_name: File.basename(IOS_IPA),
    export_method: "app-store",
    export_options: { method: "app-store-connect", signingStyle: "automatic", manageAppVersionAndBuildNumber: false },
    xcargs: "-jobs #{jobs} -allowProvisioningUpdates COMPILER_INDEX_STORE_ENABLE=NO",
    export_xcargs: "-allowProvisioningUpdates",
    xcodebuild_formatter: "",
    buildlog_path: File.join(PROJECT_ROOT, "build", "diagnostics", "fastlane")
  )
  verify_ios_ipa_version!
end

def ensure_file_exists!(path, message)
  UI.user_error!("#{message} Missing: #{path}") unless File.exist?(path)
end

def verify_ios_ipa_version!
  ensure_file_exists!(IOS_IPA, "Run `fastlane ios build_ipa` first, or omit skip_build.")
  expected = {
    "CFBundleShortVersionString" => APP_VERSION,
    "CFBundleVersion" => BUILD_NUMBER,
    "CFBundleIdentifier" => IOS_APP_IDENTIFIER
  }

  expected.each do |key, value|
    actual = get_ipa_info_plist_value(ipa: IOS_IPA, key: key).to_s
    next if actual == value

    UI.user_error!("IPA #{key} is #{actual.inspect}; expected #{value.inspect}. Rebuild with `fastlane ios build_ipa` before uploading.")
  end
end

def option_enabled?(value)
  [true, "true", "1", "yes", "y"].include?(value)
end

def ios_locales
  IOS_APP_STORE_LOCALES.select { |locale| File.directory?(File.join(IOS_METADATA_PATH, locale)) }
end

def ios_release_notes
  ios_locales.to_h do |locale|
    file_path = File.join(IOS_METADATA_PATH, locale, "release_notes.txt")
    notes = File.exist?(file_path) ? File.read(file_path).strip : RELEASE_NOTES
    [locale, notes.empty? ? RELEASE_NOTES : notes]
  end
end

def prepare_ios_metadata_path
  FileUtils.rm_rf(IOS_FILTERED_METADATA_PATH)
  FileUtils.mkdir_p(IOS_FILTERED_METADATA_PATH)

  ios_locales.each do |locale|
    FileUtils.cp_r(
      File.join(IOS_METADATA_PATH, locale),
      File.join(IOS_FILTERED_METADATA_PATH, locale)
    )
  end

  IOS_FILTERED_METADATA_PATH
end

def ios_submission_information
  {
    export_compliance_uses_encryption: false
  }
end

def ios_deliver_options(api_key)
  {
    api_key: api_key,
    app_version: APP_VERSION,
    skip_screenshots: true,
    skip_metadata: false,
    force: true,
    run_precheck_before_submit: false,
    ignore_language_directory_validation: true,
    metadata_path: prepare_ios_metadata_path,
    app_review_information: {
      notes: APP_REVIEW_NOTES
    },
    release_notes: ios_release_notes
  }
end

def ios_app_store_version
  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find App Store Connect app for #{IOS_APP_IDENTIFIER}") unless app

  versions = app.get_app_store_versions(
    filter: { platform: Spaceship::ConnectAPI::Platform::IOS },
    includes: "appStoreVersionLocalizations"
  )
  version = versions.find { |candidate| candidate.version_string == APP_VERSION }
  UI.user_error!("Could not find iOS App Store version #{APP_VERSION}") unless version

  version
end

def ensure_ios_whats_new!
  version = ios_app_store_version
  localizations = version.get_app_store_version_localizations
  notes_by_locale = ios_release_notes

  updated = []

  localizations.each do |localization|
    notes = notes_by_locale.fetch(localization.locale, RELEASE_NOTES)
    next if localization.whats_new.to_s.strip == notes

    localization.update(attributes: { whats_new: notes })
    updated << localization.locale
  end

  UI.success("Updated iOS What's New for #{updated.size} locale(s).") if updated.any?
  UI.important("No iOS What's New changes were needed.") if updated.empty?
end

# Fastlane's standard submit flow refuses an existing unresolved submission.
# Reuse only the submission whose sole item is this exact app version.
def submit_ios_review!(api_key)
  app = Spaceship::ConnectAPI::App.find(IOS_APP_IDENTIFIER)
  UI.user_error!("Could not find #{IOS_APP_IDENTIFIER}") unless app
  build = FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
    app_id: app.id, platform: "IOS", app_version: APP_VERSION,
    build_version: BUILD_NUMBER, poll_interval: 30, timeout_duration: 900,
    return_spaceship_testflight_build: false
  )
  UI.user_error!("Build #{APP_VERSION} (#{BUILD_NUMBER}) is not valid.") unless build.processing_state == "VALID"
  submission = app.get_in_progress_review_submission(platform: "IOS")

  unless submission&.state == "UNRESOLVED_ISSUES"
    deliver(
      ios_deliver_options(api_key).merge(
        build_number: BUILD_NUMBER,
        skip_binary_upload: true,
        skip_metadata: true,
        skip_screenshots: true,
        submit_for_review: true,
        automatic_release: option_enabled?(ENV.fetch("IOS_AUTOMATIC_RELEASE", "false")),
        submission_information: ios_submission_information
      )
    )
    return
  end

  version = ios_app_store_version
  items = Spaceship::ConnectAPI::ReviewSubmissionItem.all(
    review_submission_id: submission.id, includes: "appStoreVersion"
  )
  item = items.first
  unless items.size == 1 && item.app_store_version&.id == version.id &&
         %w[REJECTED READY_FOR_REVIEW].include?(item.state)
    UI.user_error!("The unresolved review includes other items; resolve them in App Store Connect before resubmitting.")
  end

  version.select_build(build_id: build.id)
  if build.uses_non_exempt_encryption.nil?
    build.update(attributes: { usesNonExemptEncryption: false })
  end
  release_type = option_enabled?(ENV.fetch("IOS_AUTOMATIC_RELEASE", "false")) ? "AFTER_APPROVAL" : "MANUAL"
  version.update(attributes: { releaseType: release_type })

  if item.state == "REJECTED"
    Spaceship::ConnectAPI.client.tunes_request_client.patch(
      "v1/reviewSubmissionItems/#{item.id}",
      { data: { type: "reviewSubmissionItems", id: item.id, attributes: { resolved: true } } }
    )
  end
  result = submission.submit_for_review
  unless %w[WAITING_FOR_REVIEW IN_REVIEW].include?(result.state)
    UI.user_error!("Resubmission returned #{result.state}; verify App Store Connect review status.")
  end
  UI.success("Submitted #{APP_VERSION} (#{BUILD_NUMBER}) using the existing review: #{result.state}.")
end

platform :ios do
  desc "Upload the verified IPA and metadata without submitting it for review"
  lane :upload_build do
    verify_ios_ipa_version!
    api_key = app_store_api_key
    deliver(
      ios_deliver_options(api_key).merge(
        ipa: IOS_IPA,
        overwrite_screenshots: false,
        submit_for_review: false
      )
    )
    ensure_ios_whats_new!
  end

  desc "Build the obfuscated iOS IPA for the current pubspec version"
  lane :build_ipa do
    build_ios_ipa
    UI.success("Built IPA for #{APP_VERSION}+#{BUILD_NUMBER}: #{IOS_IPA}")
  end

  desc "Push iOS localized metadata and What's New text to App Store Connect"
  lane :upload_metadata do
    api_key = app_store_api_key
    deliver(
      ios_deliver_options(api_key).merge(
        overwrite_screenshots: false,
        submit_for_review: false,
        skip_binary_upload: true
      )
    )
    ensure_ios_whats_new!
  end

  desc "Patch What's New, select the uploaded build, and submit it for App Store review"
  lane :submit_existing do
    api_key = app_store_api_key
    ensure_ios_whats_new!

    submit_ios_review!(api_key)
  end

  desc "Build, upload, and submit the iOS app version for App Store review"
  lane :release do |options|
    if option_enabled?(options[:skip_build])
      verify_ios_ipa_version!
    else
      build_ios_ipa
    end

    api_key = app_store_api_key
    deliver(
      ios_deliver_options(api_key).merge(
        ipa: IOS_IPA,
        overwrite_screenshots: false,
        submit_for_review: false
      )
    )

    ensure_ios_whats_new!

    submit_ios_review!(api_key)
  end
end

platform :android do
  desc "Build the obfuscated Android App Bundle for the current pubspec version"
  lane :build_aab do
    build_android_aab
    UI.success("Built AAB for #{APP_VERSION}+#{BUILD_NUMBER}: #{ANDROID_AAB}")
  end

  desc "Push Android localized metadata to Google Play Console"
  lane :upload_metadata do
    supply(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      metadata_path: "fastlane/metadata_v2/android"
    )
  end

  desc "Build, upload, and submit the Android app bundle to Google Play"
  lane :release do |options|
    build_android_aab unless option_enabled?(options[:skip_build])
    ensure_file_exists!(ANDROID_AAB, "Run `fastlane android build_aab` first, or omit skip_build.")

    supply(
      track: ENV.fetch("ANDROID_TRACK", "production"),
      aab: ANDROID_AAB,
      metadata_path: "fastlane/metadata_v2/android",
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      release_status: ENV.fetch("ANDROID_RELEASE_STATUS", "completed"),
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: false
    )
  end

  desc "Alias for android release"
  lane :deploy do |options|
    release(skip_build: options[:skip_build])
  end
end
