rules_version = '2';

// Stage A (1.2.0 hotfix). Safe for 1.1.x clients still in the field:
// - nothing is publicly readable without auth (web guests sign in anonymously)
// - users / bills can no longer be enumerated
// - points, premium and admin fields are server-only
//
// users `get` is owner/admin plus non-anonymous active users: the 1.2.0 app
// still reads other people's user docs (QR scan, group member check and the
// publicProfiles fallback). Tighten to owner/admin once 1.2.0 is retired; the
// 2.0 app reads publicProfiles only.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isFullUser() {
      return signedIn() && !isAnonymous();
    }

    // Admins can suspend an account (users/{uid}.suspended). Suspended users
    // keep read access but cannot create or change shared data.
    //
    // A missing user doc is only "not suspended" for an account that was never
    // deleted: deleting the doc leaves an accountTombstones/{uid} marker, so
    // delete + recreate cannot launder a suspension or reset points.
    function hasTombstone(uid) {
      return exists(/databases/$(database)/documents/accountTombstones/$(uid));
    }

    function notSuspended() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('suspended', false) != true
        : !hasTombstone(request.auth.uid);
    }

    function isActiveUser() {
      return isFullUser() && notSuspended();
    }

    function isOwner(userId) {
      return isFullUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isFullUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasListField(data, field) {
      return data.keys().hasAny([field]) && data[field] is list;
    }

    function listHasUid(data, field) {
      return signedIn()
        && hasListField(data, field)
        && request.auth.uid in data[field];
    }

    function isGroupOwner(data) {
      return signedIn()
        && (
          (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid) ||
          (data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid)
        );
    }

    function isGroupMember(data) {
      return listHasUid(data, 'memberIds');
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isMemberOfGroup(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function optionalField(data, field, check) {
      return !data.keys().hasAny([field]) || check;
    }

    function currencyCode(v) {
      return v is string && v.matches('^[A-Z0-9]{2,10}$');
    }

    // Groups, trips and households (2.0). Every field is optional so 1.x
    // docs stay valid.
    function groupLedgerKeys() {
      return ['type', 'currency', 'budgetMinor', 'startDate', 'endDate',
              'simplifyDebts', 'archived', 'updatedAt'];
    }

    function validGroupLedgerFields(data) {
      return optionalField(data, 'type', data.get('type', '') in ['trip', 'home', 'couple', 'other'])
        && optionalField(data, 'currency', currencyCode(data.get('currency', '')))
        && optionalField(data, 'budgetMinor', data.get('budgetMinor', null) == null
             || (data.get('budgetMinor', 0) is int && data.get('budgetMinor', 0) >= 0
                 && data.get('budgetMinor', 0) <= 1000000000000))
        && optionalField(data, 'startDate', data.get('startDate', null) == null || data.get('startDate', null) is timestamp)
        && optionalField(data, 'endDate', data.get('endDate', null) == null || data.get('endDate', null) is timestamp)
        && optionalField(data, 'simplifyDebts', data.get('simplifyDebts', true) is bool)
        && optionalField(data, 'archived', data.get('archived', false) is bool)
        && data.get('name', '') is string
        && data.get('name', '').size() <= 120
        && (!data.keys().hasAny(['memberIds']) || (data.memberIds is list && data.memberIds.size() <= 100));
    }

    // Settlement payments and Quick IOUs. Integer minor units only.
    function validPaymentCreate(data) {
      return data.keys().hasAll(['kind', 'from', 'to', 'amountMinor', 'currency',
                                 'method', 'participants_uids', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['kind', 'from', 'to', 'fromName', 'toName', 'amountMinor',
                                'currency', 'method', 'proofUrl', 'note', 'billId', 'groupId',
                                'participants_uids', 'createdBy', 'createdAt'])
        && data.kind in ['payment', 'iou']
        && data.from is string && data.from.size() > 0 && data.from.size() <= 128
        && data.to is string && data.to.size() > 0 && data.to.size() <= 128
        && data.from != data.to
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 1000000000000
        && currencyCode(data.currency)
        && data.method is string && data.method.size() <= 40
        && optionalField(data, 'proofUrl', data.get('proofUrl', '') is string && data.get('proofUrl', '').size() <= 2048)
        && optionalField(data, 'note', data.get('note', '') is string && data.get('note', '').size() <= 200)
        && optionalField(data, 'billId', data.get('billId', '') is string && data.get('billId', '').size() <= 128)
        && optionalField(data, 'fromName', data.get('fromName', '') is string && data.get('fromName', '').size() <= 120)
        && optionalField(data, 'toName', data.get('toName', '') is string && data.get('toName', '').size() <= 120)
        // The creator is one side of it, and only the two sides can see it.
        && data.createdBy == request.auth.uid
        && (data.from == request.auth.uid || data.to == request.auth.uid)
        && data.participants_uids is list
        && request.auth.uid in data.participants_uids
        && data.participants_uids.hasOnly([data.from, data.to])
        && data.createdAt == request.time;
    }

    // Payments are a record: the creator may only add proof or a note
    // afterwards; admins may correct them.
    function validPaymentUpdate() {
      return isAdmin()
        || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUrl', 'note'])
            && optionalField(request.resource.data, 'proofUrl',
                 request.resource.data.get('proofUrl', '') is string
                 && request.resource.data.get('proofUrl', '').size() <= 2048)
            && optionalField(request.resource.data, 'note',
                 request.resource.data.get('note', '') is string
                 && request.resource.data.get('note', '').size() <= 200));
    }

    // Creators can undo a mistaken payment for 24 hours.
    function canDeletePayment() {
      return isAdmin()
        || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && request.time < resource.data.createdAt + duration.value(24, 'h'));
    }

    // Only the backend (Admin SDK) or an admin may change these.
    function protectedUserFields() {
      return [
        'isAdmin',
        'isPremium',
        'points',
        'rewardedAdCount',
        'premiumEntitlementId',
        'premiumProductId',
        'premiumStore',
        'premiumEnvironment',
        'premiumExpiresAt',
        'premiumWillRenew',
        'premiumManagementUrl',
        'premiumLastEventType',
        'premiumLastRevenueCatEventId',
        'premiumUpdatedAt',
        'suspended',
        'suspendedAt',
        'suspendedBy'
      ];
    }

    // New accounts get the 7-point welcome grant and nothing else protected.
    // A deleted account (tombstone) can never be recreated or re-granted.
    function validUserCreate() {
      let data = request.resource.data;
      return !hasTombstone(request.auth.uid)
        && !data.keys().hasAny(protectedUserFields().removeAll(['points']))
        && (!data.keys().hasAny(['points']) || data.points == 7);
    }

    // The user doc usually exists before phone setup (token sync creates it),
    // so the welcome grant is also allowed once on update, never as a reset.
    function validOwnerUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(protectedUserFields().removeAll(['points']))
        && (
          !changed.hasAny(['points'])
          || (!resource.data.keys().hasAny(['points']) && request.resource.data.points == 7
              && !hasTombstone(request.auth.uid))
        );
    }

    function billHost() {
      return signedIn() && resource.data.hostId == request.auth.uid;
    }

    function newBillHost() {
      return isActiveUser() && request.resource.data.hostId == request.auth.uid;
    }

    // 2.0 bill fields: a bill can only be filed into a group its host is in,
    // and minor-unit totals are integers.
    function validBillLedgerFields() {
      let data = request.resource.data;
      return (data.get('groupId', null) == null
          || (data.groupId is string && isMemberOfGroup(data.groupId)))
        && optionalField(data, 'totalMinor', data.get('totalMinor', 0) is int && data.get('totalMinor', 0) >= 0);
    }

    function billGroupUnchanged() {
      return request.resource.data.get('groupId', null) == resource.data.get('groupId', null);
    }

    function billMember() {
      return listHasUid(resource.data, 'participants_uids');
    }

    // Bill members (non-anonymous, active) may only touch payment state, and
    // may not add or remove participants or change who an entry belongs to.
    // Anonymous web guests write through the backend (guest-payment endpoint),
    // never directly. Rules cannot loop and have a 1000-expression budget, so
    // the first 12 entries are checked one by one. A non-host member may only
    // write bills with at most 12 participants directly; bigger bills go
    // through the backend (POST /api/split-bill/bills/<id>/guest-payment/).
    function sameParticipant(i) {
      let oldP = resource.data.participants;
      let newP = request.resource.data.participants;
      return i >= oldP.size()
        || (newP[i].get('id', null) == oldP[i].get('id', null)
            && newP[i].get('name', null) == oldP[i].get('name', null));
    }

    function participantsKeepIdentity() {
      return sameParticipant(0) && sameParticipant(1) && sameParticipant(2) && sameParticipant(3) && sameParticipant(4)
        && sameParticipant(5) && sameParticipant(6) && sameParticipant(7) && sameParticipant(8) && sameParticipant(9)
        && sameParticipant(10) && sameParticipant(11);
    }

    // memberPaymentOnly also pins id and name (not payment keys), so members
    // skip participantsKeepIdentity to stay inside the expression budget.
    // Payment keys a member may write on an entry: the 1.2.0 app writes
    // paymentProof, status and paymentTime; 2.0 adds paymentMethod. Never
    // isPaid (host confirmation) or amounts/uid/phone/photo. A member may
    // move an entry to REVIEW or PENDING, never to PAID.
    function memberPaymentEntry(i) {
      let oldP = resource.data.participants;
      let newP = request.resource.data.participants;
      return i >= oldP.size()
        || (newP[i].diff(oldP[i]).affectedKeys()
              .hasOnly(['paymentProof', 'status', 'paymentTime', 'paymentMethod'])
            && (newP[i].get('status', null) == oldP[i].get('status', null)
                || newP[i].get('status', null) in ['REVIEW', 'PENDING']));
    }

    function memberPaymentOnly() {
      return resource.data.participants.size() <= 12
        && memberPaymentEntry(0) && memberPaymentEntry(1) && memberPaymentEntry(2) && memberPaymentEntry(3)
        && memberPaymentEntry(4) && memberPaymentEntry(5) && memberPaymentEntry(6) && memberPaymentEntry(7)
        && memberPaymentEntry(8) && memberPaymentEntry(9) && memberPaymentEntry(10) && memberPaymentEntry(11);
    }

    function paymentOnlyBillUpdate() {
      return isActiveUser()
        && (resource.data.hostId == request.auth.uid || billMember())
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['participants'])
        && request.resource.data.participants is list
        && resource.data.participants is list
        && request.resource.data.participants.size() == resource.data.participants.size()
        && (resource.data.hostId == request.auth.uid
            ? participantsKeepIdentity()
            : memberPaymentOnly());
    }

    // The notification must be about a bill the writer shares with the
    // recipient: both are the host or in participants_uids. Anonymous web
    // guests are not in participants_uids; they may only notify the host.
    function notificationBill() {
      return get(/databases/$(database)/documents/bills/$(request.resource.data.data.billId)).data;
    }

    function inBill(bill, uid) {
      return bill.get('hostId', '') == uid
        || (bill.get('participants_uids', []) is list && uid in bill.get('participants_uids', []));
    }

    function validNotificationTarget(targetUid) {
      return isAdmin()
        || (
          request.resource.data.get('data', null) is map
          && request.resource.data.data.get('billId', null) is string
          && request.resource.data.data.billId.size() > 0
          && request.resource.data.data.billId.size() <= 200
          && !request.resource.data.data.billId.matches('.*/.*')
          && exists(/databases/$(database)/documents/bills/$(request.resource.data.data.billId))
          && inBill(notificationBill(), targetUid)
          && (
            isAnonymous()
              ? notificationBill().get('hostId', '') == targetUid
              : inBill(notificationBill(), request.auth.uid)
          )
        );
    }

    function validNotificationCreate() {
      return request.resource.data.keys().hasOnly([
          'title',
          'body',
          'titleKey',
          'bodyKey',
          'titleArgs',
          'bodyArgs',
          'date',
          'read',
          'data'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.date == request.time
        && optionalField(request.resource.data, 'data',
             request.resource.data.get('data', null) == null
             || (request.resource.data.get('data', null) is map
                 && request.resource.data.data.keys().size() <= 20))
        && optionalField(request.resource.data, 'titleKey',
             request.resource.data.get('titleKey', null) is string
             && request.resource.data.get('titleKey', '').size() <= 100)
        && optionalField(request.resource.data, 'bodyKey',
             request.resource.data.get('bodyKey', null) is string
             && request.resource.data.get('bodyKey', '').size() <= 100)
        && optionalField(request.resource.data, 'titleArgs',
             request.resource.data.get('titleArgs', null) is map
             && request.resource.data.get('titleArgs', {}).keys().size() <= 20)
        && optionalField(request.resource.data, 'bodyArgs',
             request.resource.data.get('bodyArgs', null) is map
             && request.resource.data.get('bodyArgs', {}).keys().size() <= 20);
    }

    // --- BILLS ---
    match /bills/{billId} {
      // Share links open a bill by id; listing is limited to your own bills.
      allow get: if signedIn();
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids)
        || (signedIn() && resource.data.hostId == request.auth.uid)
        // 2.0: members see every bill in their group (query by groupId).
        || (signedIn() && resource.data.groupId is string && isMemberOfGroup(resource.data.groupId));

      allow create: if newBillHost() && validBillLedgerFields();

      allow update: if isAdmin()
        || (billHost() && notSuspended() && (billGroupUnchanged() || validBillLedgerFields()))
        || paymentOnlyBillUpdate();

      allow delete: if isAdmin() || billHost();
    }

    // --- GROUPS ---
    match /groups/{groupId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'name',
          'createdBy',
          'createdAt',
          'members',
          'memberIds'
        ].concat(groupLedgerKeys()))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && validGroupLedgerFields(request.resource.data);

      allow get: if isAdmin()
        || isGroupOwner(resource.data)
        || isGroupMember(resource.data);
      // Queries ("my groups") must be provable from the query itself, so the
      // list rule reads memberIds directly instead of through keys() helpers.
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.memberIds)
        // 1.2.0 account deletion queries its groups by ownerId.
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      // The owner edits everything; members may update the ledger settings
      // (budget, dates, simplify, archive) but not membership or the name.
      allow update: if request.resource.data.memberIds is list
        && validGroupLedgerFields(request.resource.data)
        && (
          ((isAdmin() || isGroupOwner(resource.data))
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['name', 'members', 'memberIds'].concat(groupLedgerKeys())))
          || (isGroupMember(resource.data)
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(groupLedgerKeys()))
        );

      allow delete: if isAdmin() || isGroupOwner(resource.data);

      // --- GROUP SETTLEMENT PAYMENTS ---
      match /payments/{paymentId} {
        allow read: if isAdmin() || isMemberOfGroup(groupId);

        allow create: if isActiveUser()
          && isMemberOfGroup(groupId)
          && validPaymentCreate(request.resource.data)
          && request.resource.data.kind == 'payment'
          && request.resource.data.get('groupId', groupId) == groupId
          && request.resource.data.from in groupDoc(groupId).data.memberIds
          && request.resource.data.to in groupDoc(groupId).data.memberIds;

        allow update: if (isAdmin() || isMemberOfGroup(groupId)) && validPaymentUpdate();
        allow delete: if (isAdmin() || isMemberOfGroup(groupId)) && canDeletePayment();
      }

      // --- RECURRING BILL TEMPLATES (Pro) ---
      // A backend job turns due templates into bills.
      match /recurring/{recurringId} {
        allow read: if isAdmin() || isMemberOfGroup(groupId);

        allow create: if isActiveUser()
          && isMemberOfGroup(groupId)
          && request.resource.data.keys().hasOnly(recurringKeys().concat(['createdBy', 'createdAt', 'memberIds']))
          && request.resource.data.createdBy == request.auth.uid
          && validRecurring(request.resource.data)
          && validRecurringMembers(request.resource.data, groupId);

        allow update: if (isAdmin() || (isActiveUser() && resource.data.createdBy == request.auth.uid
                                        && isMemberOfGroup(groupId)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(recurringKeys())
          && validRecurring(request.resource.data);

        allow delete: if isAdmin()
          || (signedIn() && resource.data.createdBy == request.auth.uid)
          || isGroupOwner(groupDoc(groupId).data);
      }
    }

    function recurringKeys() {
      return ['name', 'amountMinor', 'currency', 'frequency', 'anchorDay', 'nextOn', 'active'];
    }

    function validRecurring(data) {
      return data.name is string && data.name.size() <= 120
        && data.amountMinor is int && data.amountMinor > 0 && data.amountMinor <= 1000000000
        && data.currency is string && data.currency.matches('^[A-Z]{3}$')
        && data.frequency in ['weekly', 'monthly', 'yearly']
        && data.nextOn is timestamp
        && data.active is bool
        && data.anchorDay is int && data.anchorDay >= 1 && data.anchorDay <= 31;
    }

    // A template may only name people who are in the group.
    function validRecurringMembers(data, groupId) {
      return !data.keys().hasAny(['memberIds'])
        || (data.memberIds is list
            && data.memberIds.size() <= 100
            && data.memberIds.hasOnly(groupDoc(groupId).data.memberIds));
    }

    // --- ADMIN AUDIT LOG ---
    // Admins append entries; nobody edits or deletes them from a client.
    match /adminAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['adminUid', 'action', 'targetUid', 'at', 'details'])
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.action is string && request.resource.data.action.size() <= 60
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // --- FRIEND PAYMENTS AND QUICK IOUs ---
    // Between two people, outside any group. Only the two sides read them.
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids);

      allow create: if isActiveUser()
        && validPaymentCreate(request.resource.data)
        && !request.resource.data.keys().hasAny(['groupId']);

      allow update: if validPaymentUpdate();
      allow delete: if canDeletePayment();
    }

    // Activity feed: one collection-group query over every `payments`
    // collection, limited to payments the user is a side of.
    match /{path=**}/payments/{paymentId} {
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids);
    }

    // --- PUBLIC PROFILES ---
    function validPublicProfile(data) {
      return optionalField(data, 'displayName',
               data.get('displayName', null) == null
               || (data.get('displayName', null) is string && data.get('displayName', '').size() <= 80))
        && optionalField(data, 'photoUrl',
               data.get('photoUrl', null) == null
               || (data.get('photoUrl', null) is string
                   && data.get('photoUrl', '').size() <= 500
                   && data.get('photoUrl', '').matches('^https://.*')))
        && optionalField(data, 'customPaymentMethods',
               data.get('customPaymentMethods', null) is list
               && data.get('customPaymentMethods', []).size() <= 20);
    }

    // The only per-user data other people (and guests) may read.
    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update: if isOwner(userId) && notSuspended()
        && request.resource.data.keys().hasOnly([
          'displayName',
          'photoUrl',
          'customPaymentMethods',
          'updatedAt'
        ])
        && validPublicProfile(request.resource.data);

      allow delete: if isAdmin() || isOwner(userId);
    }

    // --- PHONE CLAIMS ---
    // One doc per E.164 number so uniqueness can be checked without
    // querying the users collection.
    match /phoneClaims/{phone} {
      allow get: if isFullUser();

      allow create: if isActiveUser()
        && phone.matches('^\\+[1-9][0-9]{6,14}$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAdmin()
        || (isFullUser() && resource.data.uid == request.auth.uid);
    }

    // --- ACCOUNT TOMBSTONES ---
    // Written by the owner in the same batch that deletes users/{uid}. It
    // blocks recreating the account (points reset) and keeps a suspension
    // from being washed out by delete + recreate. Only admins can remove it.
    match /accountTombstones/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.keys().hasOnly(['deletedAt'])
            && request.resource.data.deletedAt == request.time);
      allow update, delete: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      // Owner and admin; other non-anonymous active users only because the
      // 1.2.0 app still reads other users' docs. Anonymous guests never.
      allow get: if isAdmin() || isOwner(userId) || isActiveUser();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (isOwner(userId) && validUserCreate());

      allow update: if isAdmin()
        || (isOwner(userId) && validOwnerUserUpdate());

      // Owners delete their doc together with a tombstone (2.0). The 1.2.0
      // app deletes without one, so that stays allowed while not suspended.
      // shortcut: a non-suspended user can reset to the 7-point grant this way; require the tombstone in Stage B.
      allow delete: if isAdmin()
        || (isOwner(userId)
            && (existsAfter(/databases/$(database)/documents/accountTombstones/$(userId))
                || resource.data.get('suspended', false) != true));

      // --- USER NOTIFICATIONS ---
      match /notifications/{notificationId} {
        allow read: if isAdmin() || isOwner(userId);

        // Members (and web guests, host only) can notify others about a shared
        // bill, with the expected shape. Admins may notify anyone.
        allow create: if signedIn() && notSuspended() && validNotificationCreate()
          && validNotificationTarget(userId);

        allow update: if (isAdmin() || isOwner(userId))
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read is bool;

        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
