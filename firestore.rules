rules_version = '2';

// Stage A (1.2.0 hotfix). Safe for 1.1.x clients still in the field:
// - nothing is publicly readable without auth (web guests sign in anonymously)
// - users / bills can no longer be enumerated
// - points, premium and admin fields are server-only
//
// Stage B (once 1.2.0 adoption is high): tighten users `get` to owner/admin.
// 1.2.0+ clients read other people via publicProfiles and never need it.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPERS ---
    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isFullUser() {
      return signedIn() && !isAnonymous();
    }

    function isOwner(userId) {
      return isFullUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isFullUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function hasListField(data, field) {
      return data.keys().hasAny([field]) && data[field] is list;
    }

    function listHasUid(data, field) {
      return signedIn()
        && hasListField(data, field)
        && request.auth.uid in data[field];
    }

    function isGroupOwner(data) {
      return signedIn()
        && (
          (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid) ||
          (data.keys().hasAny(['ownerId']) && data.ownerId == request.auth.uid)
        );
    }

    function isGroupMember(data) {
      return listHasUid(data, 'memberIds');
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isMemberOfGroup(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in groupDoc(groupId).data.memberIds;
    }

    function optionalField(data, field, check) {
      return !data.keys().hasAny([field]) || check;
    }

    function currencyCode(v) {
      return v is string && v.matches('^[A-Z0-9]{2,10}$');
    }

    // Groups, trips and households (2.0). Every field is optional so 1.x
    // docs stay valid.
    function groupLedgerKeys() {
      return ['type', 'currency', 'budgetMinor', 'startDate', 'endDate',
              'simplifyDebts', 'archived', 'updatedAt'];
    }

    function validGroupLedgerFields(data) {
      return optionalField(data, 'type', data.get('type', '') in ['trip', 'home', 'couple', 'other'])
        && optionalField(data, 'currency', currencyCode(data.get('currency', '')))
        && optionalField(data, 'budgetMinor', data.get('budgetMinor', null) == null
             || (data.get('budgetMinor', 0) is int && data.get('budgetMinor', 0) >= 0
                 && data.get('budgetMinor', 0) <= 1000000000000))
        && optionalField(data, 'startDate', data.get('startDate', null) == null || data.get('startDate', null) is timestamp)
        && optionalField(data, 'endDate', data.get('endDate', null) == null || data.get('endDate', null) is timestamp)
        && optionalField(data, 'simplifyDebts', data.get('simplifyDebts', true) is bool)
        && optionalField(data, 'archived', data.get('archived', false) is bool)
        && data.get('name', '') is string
        && data.get('name', '').size() <= 120
        && (!data.keys().hasAny(['memberIds']) || (data.memberIds is list && data.memberIds.size() <= 100));
    }

    // Settlement payments and Quick IOUs. Integer minor units only.
    function validPaymentCreate(data) {
      return data.keys().hasAll(['kind', 'from', 'to', 'amountMinor', 'currency',
                                 'method', 'participants_uids', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['kind', 'from', 'to', 'fromName', 'toName', 'amountMinor',
                                'currency', 'method', 'proofUrl', 'note', 'billId', 'groupId',
                                'participants_uids', 'createdBy', 'createdAt'])
        && data.kind in ['payment', 'iou']
        && data.from is string && data.from.size() > 0 && data.from.size() <= 128
        && data.to is string && data.to.size() > 0 && data.to.size() <= 128
        && data.from != data.to
        && data.amountMinor is int
        && data.amountMinor > 0
        && data.amountMinor <= 1000000000000
        && currencyCode(data.currency)
        && data.method is string && data.method.size() <= 40
        && optionalField(data, 'proofUrl', data.get('proofUrl', '') is string && data.get('proofUrl', '').size() <= 2048)
        && optionalField(data, 'note', data.get('note', '') is string && data.get('note', '').size() <= 200)
        && optionalField(data, 'billId', data.get('billId', '') is string && data.get('billId', '').size() <= 128)
        && optionalField(data, 'fromName', data.get('fromName', '') is string && data.get('fromName', '').size() <= 120)
        && optionalField(data, 'toName', data.get('toName', '') is string && data.get('toName', '').size() <= 120)
        // The creator is one side of it, and only the two sides can see it.
        && data.createdBy == request.auth.uid
        && (data.from == request.auth.uid || data.to == request.auth.uid)
        && data.participants_uids is list
        && request.auth.uid in data.participants_uids
        && data.participants_uids.hasOnly([data.from, data.to])
        && data.createdAt == request.time;
    }

    // Payments are a record: the creator may only add proof or a note
    // afterwards; admins may correct them.
    function validPaymentUpdate() {
      return isAdmin()
        || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proofUrl', 'note'])
            && optionalField(request.resource.data, 'proofUrl',
                 request.resource.data.get('proofUrl', '') is string
                 && request.resource.data.get('proofUrl', '').size() <= 2048)
            && optionalField(request.resource.data, 'note',
                 request.resource.data.get('note', '') is string
                 && request.resource.data.get('note', '').size() <= 200));
    }

    // Creators can undo a mistaken payment for 24 hours.
    function canDeletePayment() {
      return isAdmin()
        || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && request.time < resource.data.createdAt + duration.value(24, 'h'));
    }

    // Only the backend (Admin SDK) or an admin may change these.
    function protectedUserFields() {
      return [
        'isAdmin',
        'isPremium',
        'points',
        'rewardedAdCount',
        'premiumEntitlementId',
        'premiumProductId',
        'premiumStore',
        'premiumEnvironment',
        'premiumExpiresAt',
        'premiumWillRenew',
        'premiumManagementUrl',
        'premiumLastEventType',
        'premiumLastRevenueCatEventId',
        'premiumUpdatedAt'
      ];
    }

    // New accounts get the 7-point welcome grant and nothing else protected.
    function validUserCreate() {
      let data = request.resource.data;
      return !data.keys().hasAny(protectedUserFields().removeAll(['points']))
        && (!data.keys().hasAny(['points']) || data.points == 7);
    }

    // The user doc usually exists before phone setup (token sync creates it),
    // so the welcome grant is also allowed once on update, never as a reset.
    function validOwnerUserUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(protectedUserFields().removeAll(['points']))
        && (
          !changed.hasAny(['points'])
          || (!resource.data.keys().hasAny(['points']) && request.resource.data.points == 7)
        );
    }

    function billHost() {
      return signedIn() && resource.data.hostId == request.auth.uid;
    }

    function newBillHost() {
      return isFullUser() && request.resource.data.hostId == request.auth.uid;
    }

    // 2.0 bill fields: a bill can only be filed into a group its host is in,
    // and minor-unit totals are integers.
    function validBillLedgerFields() {
      let data = request.resource.data;
      return (data.get('groupId', null) == null
          || (data.groupId is string && isMemberOfGroup(data.groupId)))
        && optionalField(data, 'totalMinor', data.get('totalMinor', 0) is int && data.get('totalMinor', 0) >= 0);
    }

    function billGroupUnchanged() {
      return request.resource.data.get('groupId', null) == resource.data.get('groupId', null);
    }

    function billMember() {
      return listHasUid(resource.data, 'participants_uids');
    }

    // Participants and anonymous web guests may only touch payment state,
    // and may not add or remove participants.
    function paymentOnlyBillUpdate() {
      return signedIn()
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['participants'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == resource.data.participants.size();
    }

    function validNotificationCreate() {
      return request.resource.data.keys().hasOnly([
          'title',
          'body',
          'titleKey',
          'bodyKey',
          'titleArgs',
          'bodyArgs',
          'date',
          'read',
          'data'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.date == request.time;
    }

    // --- BILLS ---
    match /bills/{billId} {
      // Share links open a bill by id; listing is limited to your own bills.
      allow get: if signedIn();
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids)
        || (signedIn() && resource.data.hostId == request.auth.uid)
        // 2.0: members see every bill in their group (query by groupId).
        || (signedIn() && resource.data.groupId is string && isMemberOfGroup(resource.data.groupId));

      allow create: if newBillHost() && validBillLedgerFields();

      allow update: if isAdmin()
        || (billHost() && (billGroupUnchanged() || validBillLedgerFields()))
        || paymentOnlyBillUpdate();

      allow delete: if isAdmin() || billHost();
    }

    // --- GROUPS ---
    match /groups/{groupId} {
      allow create: if isFullUser()
        && request.resource.data.keys().hasOnly([
          'name',
          'createdBy',
          'createdAt',
          'members',
          'memberIds'
        ].concat(groupLedgerKeys()))
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && validGroupLedgerFields(request.resource.data);

      allow read: if isAdmin()
        || isGroupOwner(resource.data)
        || isGroupMember(resource.data);

      // The owner edits everything; members may update the ledger settings
      // (budget, dates, simplify, archive) but not membership or the name.
      allow update: if request.resource.data.memberIds is list
        && validGroupLedgerFields(request.resource.data)
        && (
          ((isAdmin() || isGroupOwner(resource.data))
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['name', 'members', 'memberIds'].concat(groupLedgerKeys())))
          || (isGroupMember(resource.data)
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(groupLedgerKeys()))
        );

      allow delete: if isAdmin() || isGroupOwner(resource.data);

      // --- GROUP SETTLEMENT PAYMENTS ---
      match /payments/{paymentId} {
        allow read: if isAdmin() || isMemberOfGroup(groupId);

        allow create: if isFullUser()
          && isMemberOfGroup(groupId)
          && validPaymentCreate(request.resource.data)
          && request.resource.data.kind == 'payment'
          && request.resource.data.get('groupId', groupId) == groupId
          && request.resource.data.from in groupDoc(groupId).data.memberIds
          && request.resource.data.to in groupDoc(groupId).data.memberIds;

        allow update: if (isAdmin() || isMemberOfGroup(groupId)) && validPaymentUpdate();
        allow delete: if (isAdmin() || isMemberOfGroup(groupId)) && canDeletePayment();
      }
    }

    // --- FRIEND PAYMENTS AND QUICK IOUs ---
    // Between two people, outside any group. Only the two sides read them.
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids);

      allow create: if isFullUser()
        && validPaymentCreate(request.resource.data)
        && !request.resource.data.keys().hasAny(['groupId']);

      allow update: if validPaymentUpdate();
      allow delete: if canDeletePayment();
    }

    // Activity feed: one collection-group query over every `payments`
    // collection, limited to payments the user is a side of.
    match /{path=**}/payments/{paymentId} {
      allow list: if isAdmin()
        || (signedIn() && request.auth.uid in resource.data.participants_uids);
    }

    // --- PUBLIC PROFILES ---
    // The only per-user data other people (and guests) may read.
    match /publicProfiles/{userId} {
      allow read: if signedIn();

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'photoUrl',
          'customPaymentMethods',
          'updatedAt'
        ]);

      allow delete: if isAdmin() || isOwner(userId);
    }

    // --- PHONE CLAIMS ---
    // One doc per E.164 number so uniqueness can be checked without
    // querying the users collection.
    match /phoneClaims/{phone} {
      allow get: if isFullUser();

      allow create: if isFullUser()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid;

      allow delete: if isAdmin()
        || (isFullUser() && resource.data.uid == request.auth.uid);
    }

    // --- USERS ---
    match /users/{userId} {
      // Stage A: get by id stays open to signed-in users for 1.1.x clients.
      allow get: if signedIn();
      allow list: if isAdmin();

      allow create: if isAdmin()
        || (isOwner(userId) && validUserCreate());

      allow update: if isAdmin()
        || (isOwner(userId) && validOwnerUserUpdate());

      allow delete: if isAdmin() || isOwner(userId);

      // --- USER NOTIFICATIONS ---
      match /notifications/{notificationId} {
        allow read: if isAdmin() || isOwner(userId);

        // App users and web guests can notify others, but only with the expected shape.
        allow create: if signedIn() && validNotificationCreate();

        allow update: if (isAdmin() || isOwner(userId))
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read is bool;

        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    // --- DEFAULT DENY ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
