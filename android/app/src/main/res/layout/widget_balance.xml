<?xml version="1.0" encoding="utf-8"?>
<!-- Balance widget. Default texts double as the gallery preview
     (android:previewLayout); onUpdate always replaces them. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_surface"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding">

    <LinearLayout
        android:id="@+id/balance_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/balance_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_you_are_owed_sample"
            android:textAlignment="viewStart"
            android:textColor="@color/widget_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ViewFlipper
            android:id="@+id/balance_amount_flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <TextView
                android:id="@+id/balance_amount_a"
                style="@style/SplitBillWidget.Amount"
                android:text="+$62.40" />

            <TextView
                android:id="@+id/balance_amount_b"
                style="@style/SplitBillWidget.Amount"
                android:text="+$62.40" />
        </ViewFlipper>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/balance_people_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_people"
                android:tint="@color/widget_muted" />

            <TextView
                android:id="@+id/balance_caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="3"
                android:textAlignment="viewStart"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/balance_message"
        style="@style/SplitBillWidget.Message"
        android:visibility="gone" />
</FrameLayout>
